rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Users collection (dev & prod)
    match /users_dev/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }
    
    // Check1 reservations (dev & prod)
    match /check1_reservations_dev/{reservationId} {
      allow read: if true;
      allow create: if isOwner(request.resource.data.user_id);
      allow update: if (isOwner(resource.data.user_id) && isOwner(request.resource.data.user_id)) || isAdmin();
      allow delete: if isOwner(resource.data.user_id) || isAdmin();
    }
    match /check1_reservations/{reservationId} {
      allow read: if true;
      allow create: if isOwner(request.resource.data.user_id);
      allow update: if (isOwner(resource.data.user_id) && isOwner(request.resource.data.user_id)) || isAdmin();
      allow delete: if isOwner(resource.data.user_id) || isAdmin();
    }
    
    // Check2 reservations (dev & prod)
    match /check2_reservations_dev/{reservationId} {
      allow read: if true;
      allow create: if isOwner(request.resource.data.user_id);
      allow update: if (isOwner(resource.data.user_id) && isOwner(request.resource.data.user_id)) || isAdmin();
      allow delete: if isOwner(resource.data.user_id) || isAdmin();
    }
    match /check2_reservations/{reservationId} {
      allow read: if true;
      allow create: if isOwner(request.resource.data.user_id);
      allow update: if (isOwner(resource.data.user_id) && isOwner(request.resource.data.user_id)) || isAdmin();
      allow delete: if isOwner(resource.data.user_id) || isAdmin();
    }
    
    // Practice reservations (dev & prod)
    match /practice_reservations_dev/{reservationId} {
      allow read: if true;
      allow create: if isOwner(request.resource.data.user_id);
      allow update: if (isOwner(resource.data.user_id) && isOwner(request.resource.data.user_id)) || isAdmin();
      allow delete: if isOwner(resource.data.user_id) || isAdmin();
    }
    match /practice_reservations/{reservationId} {
      allow read: if true;
      allow create: if isOwner(request.resource.data.user_id);
      allow update: if (isOwner(resource.data.user_id) && isOwner(request.resource.data.user_id)) || isAdmin();
      allow delete: if isOwner(resource.data.user_id) || isAdmin();
    }
    
    // Testrun reservations (dev & prod)
    match /testrun_reservations_dev/{reservationId} {
      allow read: if true;
      allow create: if isOwner(request.resource.data.user_id);
      allow update: if (isOwner(resource.data.user_id) && isOwner(request.resource.data.user_id)) || isAdmin();
      allow delete: if isOwner(resource.data.user_id) || isAdmin();
    }
    match /testrun_reservations/{reservationId} {
      allow read: if true;
      allow create: if isOwner(request.resource.data.user_id);
      allow update: if (isOwner(resource.data.user_id) && isOwner(request.resource.data.user_id)) || isAdmin();
      allow delete: if isOwner(resource.data.user_id) || isAdmin();
    }
    
    // Reservation settings (admin only, dev & prod)
    match /reservation_settings_dev/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /reservation_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Check location settings (admin only, dev & prod)
    match /check_location_settings_dev/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /check_location_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Deny all other reads/writes by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
