rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Users collection
    match /users/{userId} {
      // Users can read their own document
      // Admins can read all user documents
      allow read: if isOwner(userId) || isAdmin();
      
      // Only admins can create, update, or delete user documents
      allow write: if isAdmin();
    }
    
    // Check1 reservations
    match /check1/{reservationId} {
      // Anyone authenticated can read
      allow read: if isAuthenticated();
      
      // Users can create their own reservations
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      
      // Users can only update matching user_id reservations, and cannot modify user_id. Admins can do anything
      allow update: if (isOwner(resource.data.user_id) && request.resource.data.user_id == request.auth.uid) || isAdmin();
      
      // Users can delete their own
      allow delete: if isOwner(resource.data.user_id) || isAdmin();
    }
    
    // Check2 reservations
    match /check2/{reservationId} {
      // Anyone authenticated can read
      allow read: if isAuthenticated();
      
      // Users can create their own reservations
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      
      // Users can only update matching user_id reservations, and cannot modify user_id. Admins can do anything
      allow update: if (isOwner(resource.data.user_id) && request.resource.data.user_id == request.auth.uid) || isAdmin();
      
      // Users can delete their own
      allow delete: if isOwner(resource.data.user_id) || isAdmin();
    }
    
    // Practice reservations
    match /practice/{reservationId} {
      // Anyone authenticated can read
      allow read: if isAuthenticated();
      
      // Users can create their own reservations
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      
      // Users can only update matching user_id reservations, and cannot modify user_id. Admins can do anything
      allow update: if (isOwner(resource.data.user_id) && request.resource.data.user_id == request.auth.uid) || isAdmin();
      
      // Users can delete their own
      allow delete: if isOwner(resource.data.user_id) || isAdmin();
    }
    
    // Testrun reservations
    match /testrun/{reservationId} {
      // Anyone authenticated can read
      allow read: if isAuthenticated();
      
      // Users can create their own reservations
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      
      // Users can only update matching user_id reservations, and cannot modify user_id. Admins can do anything
      allow update: if (isOwner(resource.data.user_id) && request.resource.data.user_id == request.auth.uid) || isAdmin();
      
      // Users can delete their own
      allow delete: if isOwner(resource.data.user_id) || isAdmin();
    }
    
    // Reservation settings (admin only)
    match /reservationSettings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Check location settings (admin only)
    match /checkLocationSettings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Deny all other reads/writes by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
