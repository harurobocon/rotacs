# ==============================================================================
# RoTACS 環境変数テンプレート (.env.example)
# ==============================================================================
# ローカル開発環境では、このファイルをコピーして `.env.local` を作成してください。
# Vercelにデプロイする際は、Vercelダッシュボードの「Project Settings」->「Environment Variables」に
# 以下の環境変数を設定してください。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 【必須】Firebase Client 設定 (ブラウザに公開 / NEXT_PUBLIC_*)
# Firebase Console の プロジェクト設定 -> 全般 -> マイアプリ (Webアプリ) から取得できます。
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourApiKeyHere"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890abcdef"

# ------------------------------------------------------------------------------
# 2. 【必須】Firebase Admin SDK 設定 (サーバー専用 / 秘密鍵)
# Firebase Console の プロジェクト設定 -> サービスアカウント -> 「新しい秘密鍵の生成」で
# ダウンロードした JSON ファイルの内容を設定します。
# ※ Vercel に設定する際は改行をそのまま貼り付けるか、\n にエスケープされた形式のどちらでも対応可能です。
# ------------------------------------------------------------------------------
FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...YourPrivateKey...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 3. 【任意】Slack 連携設定 (サーバー専用)
# 未設定でもビルドおよび基本機能（予約・認証・管理など）は正常に動作します。
# Slack通知やチャンネル管理機能を利用する場合は設定してください。
# ------------------------------------------------------------------------------
# Slack Bot OAuth トークン (xoxb- で始まるトークン)
SLACK_BOT_TOKEN="xoxb-your-slack-bot-token"

# ------------------------------------------------------------------------------
# 4. 【推奨】アプリケーション基本設定
# ログインIDに付加されるドメインや、Slack通知メッセージ内のURLリンク生成に使用されます。
# ローカル開発では localhost:3000、本番環境ではデプロイ先ドメインを指定してください。
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_DOMAIN="rotacs.example.com"

# ------------------------------------------------------------------------------
# 5. 【任意】Firestore コレクション名・ドキュメントID オーバーライド
# 通常はデフォルト値が適用されるため、設定不要です。
# 開発環境と本番環境で同一Firebaseプロジェクト内のコレクションを分離したい場合等に指定します。
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_USER_COLLECTION="users"
# NEXT_PUBLIC_CHECK1_RESERVATION_COLLECTION="check1_reservations"
# NEXT_PUBLIC_CHECK2_RESERVATION_COLLECTION="check2_reservations"
# NEXT_PUBLIC_TESTRUN_RESERVATION_COLLECTION="testrun_reservations"
# NEXT_PUBLIC_PRACTICE_RESERVATION_COLLECTION="practice_reservations"
# NEXT_PUBLIC_RESERVATION_SETTINGS_COLLECTION="reservation_settings_dev"
# NEXT_PUBLIC_RESERVATION_SETTINGS_DOCUMENT_ID="main"
# NEXT_PUBLIC_CHECK_LOCATION_SETTINGS_COLLECTION="check_location_settings_dev"
# NEXT_PUBLIC_CHECK_LOCATION_SETTINGS_DOCUMENT_ID="main"
# NEXT_PUBLIC_CHECK_ITEMS_SETTINGS_COLLECTION="check_items_settings_dev"
# NEXT_PUBLIC_CHECK_ITEMS_SETTINGS_DOCUMENT_ID="main"
# NEXT_PUBLIC_DISPLAY_SETTINGS_COLLECTION="display_settings_dev"
# NEXT_PUBLIC_DISPLAY_SETTINGS_DOCUMENT_ID="main"

# ------------------------------------------------------------------------------
# 6. 【任意】管理者初期データ投入用 (CLIスクリプト用)
# `npm run seed:admin` を実行して初期管理者ユーザーを作成する際に使用します。
# ------------------------------------------------------------------------------
# ROTACS_ADMIN_MAIL="admin@rotacs.example.com"
# ROTACS_ADMIN_UID="admin"
# ROTACS_ADMIN_PASSWORD="initial-admin-password"
